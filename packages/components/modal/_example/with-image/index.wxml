<view class="wrapper">
  <xbd-button
    size="large"
    theme="primary"
    variant="outline"
    data-key="imageOnTop"
    bind:tap="showModal"
    block
  >
    图片置顶-带标题描述
  </xbd-button>
</view>

<xbd-modal
  visible="{{ imageOnTop }}"
  title="模态框标题"
  content="告知当前状态、信息和解决方法，等内容。描述文案尽可能控制在三行内"
  confirm-btn="{{ { content: '确定', variant: 'base' } }}"
  cancel-btn="取消"
  bind:confirm="closeModal"
  bind:cancel="closeModal"
>
  <image
    slot="top"
    class="modal-image"
    src="{{ imageUrl }}"
    mode="aspectFill"
  />
</xbd-modal>

