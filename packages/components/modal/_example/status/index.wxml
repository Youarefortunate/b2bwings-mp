<view class="demo-desc">带关闭按钮的模态框</view>
<xbd-button
  xbd-class="wrapper"
  theme="primary"
  size="large"
  variant="outline"
  data-key="showCloseBtn"
  bind:tap="showModal"
  block
>
  带关闭按钮的模态框
</xbd-button>
<xbd-modal
  visible="{{ showCloseBtn }}"
  title="模态框标题"
  content="告知当前状态、信息和解决方法，等内容。描述文案尽可能控制在三行内"
  close-btn
  confirm-btn="{{ { content: '警示操作', variant: 'base', theme: 'danger' } }}"
  cancel-btn="取消"
  bind:confirm="closeModal"
  bind:cancel="closeModal"
/>
