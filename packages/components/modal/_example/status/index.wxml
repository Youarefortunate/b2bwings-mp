<view class="demo-desc">文字按钮</view>
<xbd-button
  xbd-class="wrapper"
  theme="primary"
  size="large"
  variant="outline"
  data-key="showConfirm"
  bind:tap="showModal"
  block
>
  文字按钮
</xbd-button>
<xbd-modal
  visible="{{ showConfirm }}"
  title="模态框标题"
  content="告知当前状态、信息和解决方法，等内容。描述文案尽可能控制在三行内"
  confirm-btn="确定"
  cancel-btn="取消"
  bind:confirm="closeModal"
  bind:cancel="closeModal"
/>

<view class="demo-desc">水平基础按钮</view>
<xbd-button
  xbd-class="wrapper"
  theme="primary"
  size="large"
  variant="outline"
  data-key="showWarnConfirm"
  bind:tap="showModal"
  block
>
  水平基础按钮
</xbd-button>
<xbd-modal
  visible="{{ showWarnConfirm }}"
  content="告知当前状态、信息和解决方法，等内容。描述文案尽可能控制在三行内"
  confirm-btn="{{ { content: '确定', variant: 'base' } }}"
  cancel-btn="取消"
  bind:confirm="closeModal"
  bind:cancel="closeModal"
/>

<view class="demo-desc">垂直基础按钮</view>
