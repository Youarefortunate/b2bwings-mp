  <xbd-demo title="" desc="吸顶距离">
    <offset navbar-height="{{ navbarHeight }}" />
  </xbd-demo>

  <xbd-demo title="" desc="指定容器">
    <container navbar-height="{{ navbarHeight }}" />
  </xbd-demo>
</view>
