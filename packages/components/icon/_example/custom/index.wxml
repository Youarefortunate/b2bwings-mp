<view class="demo__list">
  <view class="demo__card" wx:for="{{ prefixIcons }}" wx:key="index">
    <xbd-icon
      name="{{ item }}"
      size="48rpx"
      prefix="xbd"
      data-name="{{ item }}"
      data-type="prefix"
      bind:click="onIconTap"
    />
    <view class="demo__card-name">{{ item }}</view>
  </view>
</view>
