<xbd-popup
  visible="{{ visible }}"
  bind:visible-change="onVisibleChange"
  placement="bottom"
>
  <view class="block">
    <view class="header">
      <view class="btn btn--cancel" aria-role="button" bind:tap="handleClose">
        取消
      </view>
      <view class="title">标题文字</view>
      <view
        class="btn btn--confirm"
        aria-role="button"
        bind:tap="handleClose"
      >
        确定
      </view>
    </view>
  </view>
</xbd-popup>

<xbd-button
  block
  size="large"
  variant="outline"
  theme="primary"
  bind:tap="handlePopup"
>
  底部弹出层-带标题及操作
</xbd-button>
