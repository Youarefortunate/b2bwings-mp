<xbd-popup
  visible="{{ visible }}"
  bind:visible-change="onVisibleChange"
  placement="bottom"
  showOverlay="{{ showOverlay }}"
  overlayProps="{{ overlayProps }}"
  closeBtn="{{ !showOverlay }}"
>
  <view class="block">
    <view class="content">
      <view>{{ contentText }}</view>
      <xbd-button
        wx:if="{{ !showOverlay }}"
        size="medium"
        theme="primary"
        bind:tap="onClose"
      >
        我知道了
      </xbd-button>
    </view>
  </view>
</xbd-popup>

<view class="button-group">
  <xbd-button
    block
    size="large"
    variant="outline"
    theme="primary"
    bind:tap="handlePopup"
    data-type="custom-color"
  >
    自定义遮罩背景色 (蓝色半透明)
  </xbd-button>

  <xbd-button
    block
    size="large"
    variant="outline"
    theme="primary"
    bind:tap="handlePopup"
    data-type="no-overlay"
  >
    不显示遮罩层
  </xbd-button>
</view>
