<view
  class="pullDownList xbd-class {{ childBoxHeight > 0 ? 'actived' : '' }}"
>
  <view
    wx:if="{{ !!childArr.length }}"
    class="switchBox"
    aria-role="button"
    aria-expanded="{{ !!childBoxHeight }}"
    catch:tap="switchHandle"
  >
    <view class="name">{{ name }}</view>
    <xbd-icon
      name="{{ icon }}"
      size="28rpx"
      color="#0052d9"
      xbd-class="icon"
      aria-hidden
    />
  </view>
  <view
    class="childBox"
    style="height: {{ childBoxHeight }}rpx"
    aria-hidden="{{ childBoxHeight ? '' : true }}"
  >
    <view
      class="child"
      wx:for="{{ childArr }}"
      wx:key="name"
      data-item="{{ item }}"
      aria-role="button"
      bind:tap="tapChild"
    >
      {{ item.name }} {{ item.label }}
      <xbd-icon
        name="chevron-right"
        size="28rpx"
        color="var(--xbd-text-color-placeholder)"
        xbd-class="child-icon"
        aria-hidden
      />
    </view>
  </view>
</view>
