{
  "extends": "tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["miniprogram-api-typings", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
