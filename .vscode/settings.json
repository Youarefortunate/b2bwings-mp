{
    // 文件关联
    "files.associations": {
      "*.cjson": "jsonc",
      "*.wxss": "css",
      "*.wxs": "javascript",
      "*.wxml": "wxml"
    },

    // 编辑器基础配置
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.trimAutoWhitespace": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "explicit"
    },
    "[json]": {
      "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[jsonc]": {
      "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[wxml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "prettier.trailingComma": "none"
    },
    "prettier.prettierPath": "./node_modules/prettier", // 强制使用项目里的 prettier
    "prettier.requireConfig": true,
    "prettier.documentSelectors": ["**/*.wxml"],

    // 文件和文件夹排除
    "files.exclude": {
        "**/node_modules": false,
        "**/miniprogram_npm": false,
        "**/.git": true,
        "**/.DS_Store": true,
        "jsconfig.json": true,
        "typings/wx.d.ts": true
    },
    // 格式化配置
    "files.watcherExclude": {
        "jsconfig.json": true,
        "typings/wx.d.ts": true
    },
    // 搜索排除
    "search.exclude": {
        "**/node_modules": true,
        "**/miniprogram_npm": true,
        "**/*.log": true
    },


    // JavaScript/TypeScript 配置
    "javascript.preferences.importModuleSpecifier": "relative",
    "typescript.preferences.importModuleSpecifier": "relative",

    // UnoCSS 配置
    "unocss.root": ["."],

    // 编译英雄配置
    "compile-hero.disable-compile-files-on-did-save-code": true,

    // Emmet 配置 (适用于 WXML)
    "emmet.includeLanguages": {
      "wxml": "html"
    },
    "emmet.excludeLanguages": ["markdown"],

    // 工作区设置
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
      "README.md": "README.*.md",
      "*.js": "${capture}.js.map,${capture}.min.js,${capture}.d.ts,${capture}.d.ts",
      "*.json": "${capture}.*.json",
      "package.json": "package-lock.json,yarn.lock",
      // ,props.ts
      "*.wxml": "${capture}.ts,${capture}.js,${capture}.json,${capture}.scss,${capture}.wxss,${capture}.less"
    },

    // 禁用小程序插件自动生成配置文件 (防止生成 jsconfig.json 和 wx.d.ts)
    "minapp-vscode.disableAutoConfig": true,
}
